---
import "@fontsource/noto-serif-sc/400.css"
import "@fontsource/noto-serif-sc/500.css"
import "@/styles/reset.css"
import "@/styles/fonts.css"
import "@/styles/color.css"
import "@/styles/typography.css"
import "@/styles/typography-headings.css"
import "@/styles/typography-inline.css"
import "@/styles/typography-lists.css"
import "@/styles/typography-block.css"
import "@/styles/typography-tables.css"
import "@/styles/callout.css"
import "@/styles/sidenote.css"
import "@/styles/layout.css"
import "@/styles/shape.css"
import "@/styles/print.css"

import Footer from "@/components/Footer.astro"
import MetaHead from "@/components/MetaHead.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import { SITE } from "@/consts"
import { getLang, ui } from "@/i18n"

type Props = { crumbs?: { label: string; href: string }[]; wide?: boolean }

const { wide = false } = Astro.props
const lang = getLang(Astro.url)
---

<html lang={ui[lang].locale} dir={SITE.dir} data-theme="dark">
  <MetaHead>
    <slot name="head" />
  </MetaHead>
  <body>
    <scroll-progress aria-hidden="true"></scroll-progress>
    <SiteHeader />
    <page-grid class:list={{ wide }}>
      <page-header>
        {Astro.slots.has("toc") && (
            <page-toc><slot name="toc" /></page-toc>
          )}
      </page-header>
      <page-content>
        <main id="main"><slot /></main>
        {Astro.slots.has("actions") && <nav class="article-actions" aria-label={lang === "zh" ? "相邻文章" : "Adjacent posts"}><slot name="actions" /></nav>}
        <page-footer><Footer /></page-footer>
      </page-content>
    </page-grid>
  </body>
</html>

<style>
  scroll-progress {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 2px;
    z-index: 50;
    background: var(--accent);
    transform-origin: 0 50%;
    scale: 0 1;
    animation: scroll-progress-grow linear;
    animation-timeline: scroll(root block);

    @media (width < 64rem) {
      display: none;
    }
  }

  @keyframes scroll-progress-grow {
    to {
      scale: 1 1;
    }
  }

  page-grid {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 690px) minmax(0, 1fr);
    gap: var(--grid-gutter);
    max-width: var(--grid-max-width);
    min-height: 100svh;
    margin-inline: auto;
    padding-inline: var(--grid-gutter);
    padding-block-start: var(--page-offset-top);

    @media (width < 64rem) {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      padding-block-start: 0;
    }
  }

  page-header {
    display: contents;

    @media (width < 64rem) {
      display: block;
      grid-column: 1 / -1;
      position: sticky;
      top: 0;
      z-index: 10;
      min-width: 0;
      margin-inline: calc(-1 * var(--grid-gutter));
    }
  }

  page-nav {
    display: block;
    min-width: 0;
    grid-column: 1 / 3;
    grid-row: 1;

    @media screen and (width >= 64rem) {
      position: fixed;
      inset-block: var(--page-offset-top) var(--page-offset-bottom);
      inset-inline-start: var(--grid-edge);
      width: calc(2 * var(--grid-column-width) + var(--grid-gutter));
    }
  }

  page-toc {
    display: block;
    min-width: 0;
    grid-column: 3;
    grid-row: 1;

    @media screen and (width >= 64rem) {
      position: sticky;
      top: 32px;
      align-self: start;
      max-height: calc(100vh - 64px);
    }
  }

  page-content {
    display: flex;
    flex-direction: column;
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
    margin-block-start: -0.1em;

    main {
      flex: 1;
    }

    page-footer {
      display: block;
      margin-block-start: var(--space-xl);
    }

    @media (width < 64rem) {
      grid-column: 1 / -1;
      grid-row: auto;
      inline-size: 100%;
      max-inline-size: var(--measure);
      margin-inline: auto;
    }
  }

  page-grid.wide { grid-template-columns: 1fr; max-width: 1280px; padding-inline: 36px; }
  page-grid.wide page-content { grid-column: 1; max-inline-size: none; }
  page-grid.wide page-header { display: none; }
  .article-actions { display:flex; gap:12px; border-top:1px solid var(--border); padding-top:20px; margin-top:40px; }
  @media(width < 64rem) {
    page-grid { padding-block-start: 36px; }
    page-header { position:static; }
    page-toc { margin-bottom:24px; }
    page-grid.wide {padding-inline:20px;}
    .article-actions {display:none;}
  }
</style>
