---
import { NEWSLETTER } from "@/consts"
import { type Lang, ui } from "@/i18n"

type Props = { lang: Lang }
const { lang } = Astro.props
const tr = ui[lang]

const username = NEWSLETTER.buttondownUsername
const action = `https://buttondown.com/api/emails/embed-subscribe/${username}`
const rssHref = lang === "zh" ? "/zh/rss.xml" : "/rss.xml"
---

{username && (
  <subscribe-cta>
    <p class="sc-note">{tr.newsletterNote}</p>
    <form
      class="sc-form"
      action={action}
      method="post"
      target="_blank"
      data-popup={`https://buttondown.com/${username}`}
    >
      <label class="sc-label" for="bd-email">{tr.newsletterEmailLabel}</label>
      <input
        id="bd-email"
        class="sc-input"
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder={tr.newsletterPlaceholder}
      />
      <input type="hidden" name="embed" value="1" />
      <button class="sc-submit" type="submit">{tr.newsletterButton}</button>
    </form>
    <p class="sc-alt"><a href={rssHref}>{tr.newsletterRss}</a></p>
    <p class="sc-done" role="status" aria-live="polite" hidden>{tr.newsletterDone}</p>
  </subscribe-cta>
)}

<script>
  // Progressive enhancement: without JS the form POSTs to Buttondown and its
  // hosted confirmation page opens in a new tab. With JS we submit in the
  // background (no-cors, so the double opt-in email still fires) and swap in an
  // inline confirmation so the reader never leaves the essay.
  document.querySelectorAll<HTMLElement>("subscribe-cta").forEach((cta) => {
    const form = cta.querySelector<HTMLFormElement>("form")
    const done = cta.querySelector<HTMLElement>(".sc-done")
    if (!form || !done) return

    form.addEventListener("submit", (e) => {
      e.preventDefault()
      fetch(form.action, {
        method: "POST",
        mode: "no-cors",
        body: new FormData(form),
      })
        .then(() => {
          form.hidden = true
          cta.querySelector<HTMLElement>(".sc-alt")?.setAttribute("hidden", "")
          done.hidden = false
        })
        .catch(() => {
          // network/CORS failure → fall back to Buttondown's hosted page
          window.open(form.dataset.popup, "_blank", "noopener")
        })
    })
  })
</script>

<style>
  subscribe-cta {
    display: block;
    margin-block-start: var(--space-l);
    padding: var(--space-s);
    background: var(--muted);
    border: 1px solid var(--border);
    /* terracotta masthead rule — ties the block into the site's accent language */
    border-block-start: 2px solid var(--accent);
    border-radius: var(--radius-lg);
  }

  .sc-note {
    margin: 0;
    font-size: var(--step-0);
    color: var(--foreground);
  }

  .sc-form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-xs);
  }

  .sc-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .sc-input {
    flex: 1 1 12rem;
    min-width: 0;
    padding: var(--space-2xs) var(--space-xs);
    font: inherit;
    font-size: var(--step--1);
    color: var(--foreground);
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);

    &::placeholder {
      color: var(--muted-foreground);
      opacity: 0.7;
    }
  }

  .sc-submit {
    flex: 0 0 auto;
    padding: var(--space-2xs) var(--space-s);
    font: inherit;
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    color: var(--primary-foreground);
    background: var(--accent);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    cursor: pointer;

    &:hover {
      opacity: 0.9;
    }
  }

  .sc-alt {
    margin: var(--space-2xs) 0 0;
    font-size: var(--step--1);
    color: var(--muted-foreground);

    a {
      color: var(--muted-foreground);
      text-decoration: underline;
      text-decoration-color: color-mix(
        in oklab,
        var(--muted-foreground) 40%,
        transparent
      );
      text-underline-offset: 0.15em;

      &:hover {
        color: var(--accent);
      }
    }
  }

  .sc-done {
    margin: 0;
    font-size: var(--step-0);
    color: var(--accent);
  }
</style>
