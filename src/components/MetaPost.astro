---
import { getCollection, getEntries, type CollectionEntry } from "astro:content"
import { pageTitle, postSlug, ogSlug } from "@/lib/content"
import { type Lang, ui, postHref, aboutHref } from "@/i18n"

type Props = {
  post: CollectionEntry<"blog">
  canonical?: string
}

const { post, canonical: canonicalPath } = Astro.props
const { title, description, date, image } = post.data
const lang = (post.data.lang ?? "en") as Lang
const tr = ui[lang]

const base = Astro.site ?? new URL(Astro.url.origin)
const authors = await getEntries(post.data.authors)
const authorNames = authors.map((author) => author.data.name)
const url = new URL(Astro.url.pathname, base)
const canonical = new URL(canonicalPath ?? Astro.url.pathname, base)
// Prefer an explicit frontmatter image; otherwise use the per-post OG image
// generated at build time by /og/[route].png.ts.
const ogImage = image
  ? new URL(image.src, base)
  : new URL(`/og/${ogSlug(post)}.png`, base)

// hreflang: emit only when the same slug truly exists in the other language
const slug = postSlug(post)
const otherLang: Lang = lang === "zh" ? "en" : "zh"
const counterpart = (await getCollection("blog")).find(
  (p) =>
    (p.data.lang ?? "en") === otherLang &&
    postSlug(p) === slug &&
    !p.data.draft,
)
// trailing slash to match the canonical URL form
const hrefFor = (l: Lang) => new URL(`${postHref(l, slug)}/`, base).toString()

// JSON-LD (BlogPosting + Person) — structured data for search & AI engines
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: date.toISOString(),
  inLanguage: tr.locale,
  mainEntityOfPage: canonical.toString(),
  image: ogImage.toString(),
  author: authors.map((a) => ({
    "@type": "Person",
    name: a.data.name,
    url: new URL(aboutHref(lang), base).toString(),
  })),
  publisher: {
    "@type": "Person",
    name: authorNames[0] ?? tr.citeSource,
    url: new URL(aboutHref(lang), base).toString(),
  },
})
---

<title>{pageTitle(title, lang)}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>

<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="article">
<meta property="og:url" content={url}>
<meta property="og:site_name" content={tr.siteName}>
<meta property="og:locale" content={tr.ogLocale}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:alt" content={title}>

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:image:alt" content={title}>
{authorNames.length > 0 && (
    <meta name="twitter:creator" content={authorNames.join(", ")} />
  )}

<meta property="article:published_time" content={date.toISOString()}>
{authorNames.map((name) => <meta property="article:author" content={name} />)}

{counterpart && (
    <>
      <link rel="alternate" hreflang={lang} href={hrefFor(lang)} />
      <link rel="alternate" hreflang={otherLang} href={hrefFor(otherLang)} />
      <link rel="alternate" hreflang="x-default" href={hrefFor("en")} />
    </>
  )}

<script type="application/ld+json" set:html={jsonLd} />

